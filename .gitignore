# .gitignore 模板
# 用法：把这个文件复制到你的学习仓库根目录，并重命名为 .gitignore
#   Windows 命令行：copy ..\.gitignore-template .gitignore
# 作用：让 Git 忽略不该提交的文件（尤其是密钥！）

# ---------- 密钥与配置（最重要，绝不提交）----------
.env
.env.*
!.env.example
*.key
secrets.json

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/

# ---------- 编辑器与系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------- 数据与产物（体积大，不入库）----------
data/raw/
*.pdf
*.sqlite
*.db
models/
logs/
*.log

# ---------- 临时文件 ----------
*.tmp
_write_test.tmp
